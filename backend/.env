# Mostra apenas erros no console do backend
LOG_LEVEL=error

# Variáveis de Ambiente para Desenvolvimento Local


# String de conexão para o seu banco de dados PostgreSQL local
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#DATABASE_URL="postgres://postgres:sua_nova_senha_aqui@localhost:5432/postgres"

# Porta do backend (usada pelo frontend)
PORT=3001

# Segredo para os tokens JWT. Pode ser qualquer string segura.
JWT_SECRET="meu-segredo-local-super-secreto"