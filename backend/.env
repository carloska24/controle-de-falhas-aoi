## Exemplo de variáveis de ambiente para desenvolvimento
# NÃO COMITAR segredos reais. Use este arquivo como referência apenas.

JWT_SECRET=uma-senha-fraca-para-dev
DEV_SEED_KEY=local-dev-2024
PORT=3001
# Configuração CORS (Origem permitida no modo de produção)
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
NODE_ENV=development


