generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusOM {
  em_andamento
  pausada
  finalizada
}

model ordens_manufatura {
  omNumber       String @id
  status         StatusOM
  startTime      BigInt
  endTime        BigInt?
  pausedTime     BigInt @default(0)
  pauseStartedAt BigInt?
  elapsedAtPause BigInt?
  qtdlote        Int?
  version        Int @default(0)
  rastreamentoInspecao Boolean @default(true)
  eventos        eventos_om[]
  inspecoes      placas_inspecionadas[]

  @@index([status])
}

model placas_inspecionadas {
  omNumber     String
  serial       String
  temFalha     Boolean
  registradaEm DateTime @default(now())
  registradaPor Int
  ordem        ordens_manufatura @relation(fields: [omNumber], references: [omNumber])

  @@id([omNumber, serial])
  @@index([registradaEm])
}

model eventos_om {
  id         String @id @default(uuid())
  omNumber   String
  action     String
  actorId    Int
  actorName  String
  occurredAt DateTime @default(now())
  snapshot   Json
  ordem      ordens_manufatura @relation(fields: [omNumber], references: [omNumber])

  @@index([omNumber, occurredAt])
}

model oms_ativas {
  omNumber   String @id
  startTime  BigInt?
  pausedTime BigInt? @default(0)
  qtdlote    Int?
}

model oms_finalizadas {
  omNumber   String @id
  startTime  BigInt?
  endTime    BigInt?
  pausedTime BigInt?
  qtdlote    Int?
}

model oms_pausadas {
  omNumber       String @id
  startTime      BigInt?
  pausedTime     BigInt?
  pauseStartedAt BigInt?
  elapsedAtPause BigInt?
  qtdlote        Int?
}

model registros {
  id          String @id
  om          String
  qtdlote     Int?
  serial      String?
  designador  String?
  tipodefeito String?
  pn          String?
  descricao   String?
  obs         String?
  createdat   String
  status      String?
  operador    String?
  prioridade  String?
  version     Int @default(0)
  requisicao_vinculo requisicao_registros?

  @@index([om], map: "idx_registros_om")
  @@index([status], map: "idx_registros_status")
  @@index([createdat], map: "idx_registros_createdat")
  @@index([operador], map: "idx_registros_operador")
  @@index([om, status], map: "idx_registros_om_status")
}

model requisicoes {
  id         Int     @id @default(autoincrement())
  om         String
  items      String
  status     String? @default("pendente")
  created_at String? @default("CURRENT_TIMESTAMP")
  created_by String?
  registros_vinculados requisicao_registros[]

  @@index([om], map: "idx_requisicoes_om")
  @@index([status], map: "idx_requisicoes_status")
  @@index([created_at], map: "idx_requisicoes_created_at")
}

model requisicao_registros {
  registro_id String @id
  requisicao_id Int
  registro registros @relation(fields: [registro_id], references: [id], onDelete: Restrict)
  requisicao requisicoes @relation(fields: [requisicao_id], references: [id], onDelete: Cascade)

  @@index([requisicao_id])
}

model users {
  id            Int    @id @default(autoincrement())
  name          String
  username      String @unique
  password_hash String
  role          String @default("operator")
  session_version Int @default(0)
}
