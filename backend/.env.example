## Exemplo de variáveis de ambiente para desenvolvimento
# NÃO COMITAR segredos reais. Use este arquivo como referência apenas.

JWT_SECRET=trocar-em-producao-32-caracteres-minimo
DATABASE_URL=postgresql://usuario:senha@localhost:5432/aoi_db
# Pool padrão: 10 conexões; use 1 no banco temporário PGlite de teste.
DATABASE_POOL_MAX=10
PORT=3001
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
NODE_ENV=development
DEBUG_ROUTES_ENABLED=false

# Somente para `npm run admin:create`, nunca durante o build.
# Defina ADMIN_USERNAME, ADMIN_NAME e ADMIN_PASSWORD no terminal.
# Use uma senha exclusiva com pelo menos 12 caracteres e remova-a da sessão após o uso.
